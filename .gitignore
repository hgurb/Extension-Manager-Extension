# Keep the published extension small; local previews and tooling stay local.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/manifest.json
!/ui.js
!/popup.html
!/popup.css
!/popup.js
!/manager.html
!/manager.css
!/manager.js
!/icons/
/icons/*
!/icons/icon-16.png
!/icons/icon-32.png
!/icons/icon-48.png
!/icons/icon-128.png
!/icons/icon.svg
